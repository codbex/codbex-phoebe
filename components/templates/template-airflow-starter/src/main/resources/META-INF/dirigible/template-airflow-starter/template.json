{
    "name": "Apache Airflow Starter",
    "description": "Apache Airflow Starter Template",
    "sources": [
        {
            "location": "/template-airflow-starter/build-linux.sh",
            "action": "generate",
            "rename": "build-linux.sh"
        },
        {
            "location": "/template-airflow-starter/build-mac.sh",
            "action": "generate",
            "rename": "build-mac.sh"
        },
        {
            "location": "/template-airflow-starter/config/.empty",
            "action": "generate",
            "rename": "config/.empty"
        },
        {
            "location": "/template-airflow-starter/plugins/.empty",
            "action": "generate",
            "rename": "plugins/.empty"
        },
        {
            "location": "/template-airflow-starter/dags/example_dag.py.template",
            "action": "generate",
            "engine": "velocity",
            "rename": "dags/{{fileName}}.py"
        },
        {
            "location": "/template-airflow-starter/project.json",
            "action": "generate",
            "rename": "project.json"
        }
    ],
    "parameters": [
        {
            "name": "dagId",
            "label": "The id of the generated DAG"
        }
    ],
    "order": -200
}
